{
    "name": "mprober-web-ui",
    "version": "0.12.0",
    "private": true,
    "description": "The web UI of M Prober, which is served by the `mprober web` command.",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "test": "vitest run",
        "dev": "vite",
        "clean": "rimraf ../front-end/index.html ../front-end/js ../front-end/css ../front-end/fonts",
        "build": "npm run clean && tsc --noEmit && vite build",
        "preview": "vite preview",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "knip": "knip",
        "check": "npm run lint && npm run format:check && npm run knip",
        "prepare": "node setup-git-hooks.mjs"
    },
    "dependencies": {
        "@fontsource-variable/roboto-mono": "^5.3.0",
        "@mantine/core": "^9.5.2",
        "@mantine/hooks": "^9.5.2",
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
    },
    "devDependencies": {
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@vitejs/plugin-react": "^6.1.0",
        "jsdom": "^30.0.1",
        "knip": "^6.32.2",
        "oxfmt": "^0.65.0",
        "oxlint": "^1.80.0",
        "oxlint-tsgolint": "^7.0.2001",
        "postcss": "^8.5.26",
        "postcss-preset-mantine": "^1.18.0",
        "postcss-simple-vars": "^7.0.1",
        "rimraf": "^6.1.3",
        "typescript": "^7.0.2",
        "vite": "^8.2.2",
        "vitest": "^4.1.11"
    },
    "engines": {
        "node": ">=24"
    }
}
